{
  "name": "ply",
  "version": "0.2.5",
  "private": true,
  "description": "Custom Electron browser with a built-in Naver automation agent, attachable over CDP",
  "license": "MIT",
  "author": "ganggyunggyu",
  "homepage": "https://ply.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ganggyunggyu/ply.git"
  },
  "bugs": {
    "url": "https://github.com/ganggyunggyu/ply/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build-api-docs.mjs && node build.mjs",
    "api:docs": "node scripts/build-api-docs.mjs",
    "api:sync": "node scripts/sync-api-snapshots.mjs",
    "dev": "npm run build && electron dist/main.js",
    "dist": "npm run build && electron-builder --publish never",
    "typecheck": "tsc --noEmit",
    "install:app": "npm run dist && rm -rf \"/Applications/Ply.app\" && cp -R \"out/mac-arm64/Ply.app\" /Applications/ && echo \"설치 완료: /Applications/Ply.app\"",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run test"
  },
  "build": {
    "appId": "app.ply.browser",
    "productName": "Ply",
    "directories": {
      "output": "out",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*"
    ],
    "afterPack": "scripts/adhoc-sign.mjs",
    "mac": {
      "icon": "build-resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "Ply-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Ply-Setup-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "playwright-core": "^1.62.1"
  }
}
